import pandas as pd
import seaborn as sns


df = pd.read_csv("Student Social Media And Mental Health Impact.csv")
df.head()


df.describe()


df.info()


df.isnull().sum()


df.duplicated().sum()





sns.histplot(df,x="Mental_Health_Score", kde=True)


sns.heatmap(df.corr(numeric_only=True),annot=True) 





df.drop_duplicates(inplace=True)


df["Physical_Activity_Hours"] = df["Physical_Activity_Hours"].clip(lower=0)


#Checking skewing
num_cols = df.select_dtypes(include="number")
num_cols.skew()





Top_countries = df["Country"].value_counts().index[:10].to_list()
def group_countries(country):
  if country in Top_countries:
    return country
  else:
    return 'Other'
df["Country"] = df["Country"].apply(group_countries)


from sklearn.model_selection import train_test_split

skew_col = ["Study_Hours"]
other_numerical_col = ["Age","Avg_Daily_Usage_Hours","Physical_Activity_Hours",'Daily_Unlocks','Sleep_Hours_Per_Night']
ordinal_col = ["Stress_Level"]
nominal_col = ['Gender', 'Country', 'Academic_Level', 'Most_Used_Platform','Purpose_Of_Use']

feature = df[skew_col+ other_numerical_col+ ordinal_col+ nominal_col]
y = df.iloc[:,-1]

X_train, X_test, y_train, y_test = train_test_split(feature, y, test_size=0.2, random_state=42)





from sklearn.pipeline import Pipeline
from sklearn.preprocessing import OrdinalEncoder,OneHotEncoder,FunctionTransformer,StandardScaler
import numpy as np
from sklearn.compose import ColumnTransformer

skew_pipeline = Pipeline(steps=[
    ("skew", FunctionTransformer(np.log1p)),
    ("scale", StandardScaler())
])

other_numerical_pipeline = Pipeline(steps=[

    ("scale", StandardScaler())
])

ordinal_piepline = Pipeline(steps=[
    ("encode", OrdinalEncoder())
])

nominal_pipeline = Pipeline(steps=[
    ("encode", OneHotEncoder())
])

preprocessor = ColumnTransformer(transformers=[
    ("skew_num", skew_pipeline, skew_col),
    ("other_num", other_numerical_pipeline, other_numerical_col),
    ("ordinal", ordinal_piepline, ordinal_col),
    ("nominal", nominal_pipeline, nominal_col)

])


from sklearn.ensemble import RandomForestRegressor

Rf_regressor_pipeline = Pipeline(steps=[
    ("preprocessor", preprocessor),
    ("regressrion", RandomForestRegressor())
])


from sklearn.metrics import r2_score
Rf_regressor_pipeline.fit(X_train, y_train)
pred = Rf_regressor_pipeline.predict(X_test)
r2_score(y_test, pred)


from sklearn.model_selection import RandomizedSearchCV

param_grid = {  
        'regressrion__n_estimators': [100, 200, 300, 400, 500],  
        'regressrion__max_depth': [None, 10, 20, 30, 40, 50],  
        'regressrion__min_samples_split': [2, 5, 10],  
        'regressrion__min_samples_leaf': [1, 2, 4]  
    }
randomized = RandomizedSearchCV(
    estimator=Rf_regressor_pipeline,  
    param_distributions=param_grid,
    n_iter=50,  
    cv=5,  
    verbose=2,  
    random_state=42,  
    n_jobs=-1  
)  
randomized.fit(X_train, y_train)


best_rf = randomized.best_estimator_
y_pred = best_rf.predict(X_test)
r2_score(y_test, y_pred)



import joblib

joblib.dump(best_rf,"Mental_health.pkl")






